{
  "version": 2,
  "buildCommand": "yarn vercel-build",
  "installCommand": "yarn install",
  "framework": "angular",
  "outputDirectory": "dist/TravelBlog",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
    ],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/TravelBlog"
      }
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/"
    }
  ]
}
