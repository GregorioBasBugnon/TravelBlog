{
  "version": 2,
  "builds": [
    {
      "src": "dist/travel-blog",
      "use": "@vercel/static"
    },
    { 
      "src": "angular.json",
      "use": "@vercel/static-build",
      "config": { 
        "distDir": "dist" 
      } 
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
